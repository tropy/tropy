{
  "name": "tropy",
  "productName": "Tropy",
  "version": "1.18.0-beta.7",
  "private": true,
  "author": "The Tropy Developers and Contributors",
  "description": "Explore your research photos",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://tropy.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/tropy/tropy"
  },
  "bugs": {
    "url": "https://github.com/tropy/tropy/issues"
  },
  "engines": {
    "node": ">=24.15",
    "npm": ">=12"
  },
  "main": "lib/main/index.js",
  "type": "module",
  "imports": {
    "#sqlite/transport": {
      "renderer": "./src/sqlite/renderer.js",
      "default": "./src/sqlite/node.js"
    },
    "#tropy/*.js": "./src/*.js",
    "#vendor/*.js": "./vendor/*.js"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "rollup": "rollup -c",
    "rollup:dev": "NODE_ENV=development rollup -c",
    "rollup:profile": "PROFILE=true rollup -c",
    "prebuild": "npm run clean && npm run rollup",
    "build": "node scripts/build.js",
    "pack": "node scripts/pack.js",
    "legal": "node scripts/legal.js",
    "lint": "npm run -s lint:js && npm run -s lint:css",
    "lint:js": "eslint",
    "lint:css": "stylelint 'src/stylesheets/**/*.scss'",
    "log:view": "cat tmp/log/tropy.log | node scripts/log-remap.js | node scripts/log-viewer.js",
    "log:tail": "tail -q -F tmp/log/tropy.log 2> /dev/null | node scripts/log-remap.js | node scripts/log-viewer.js",
    "log:debug": "node scripts/log-remap.js -fv | node scripts/log-viewer.js",
    "start": "electron --app . --dev --data tmp --cache tmp/cache --logs tmp/log",
    "rebuild": "node scripts/rebuild.js",
    "coverage": "c8 npm test",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "spark --no-sandbox",
    "test:e2e": "node --test --test-concurrency=1 --test-global-setup=test/e2e/setup.js --test-reporter=spark-chamber/reporters/sparks test/e2e/*.test.js",
    "preversion": "npm run lint && npm test",
    "version": "node scripts/version.js && git add res/linux CITATION.cff"
  },
  "c8": {
    "all": true,
    "excludeAfterRemap": true,
    "include": [
      "src/**"
    ]
  },
  "spark": {
    "ui": "bdd",
    "timeout": 2000,
    "reporters": [
      "sparks"
    ],
    "mainGlobPatterns": [
      "test/{common,main}/**/*.test.js"
    ],
    "rendererGlobPatterns": [
      "test/*.test.js",
      "test/!(main|support|fixtures|e2e)/**/*.test.{js,cjs}"
    ],
    "url": "test/support/view.html",
    "preload": [
      "test/support/conditions.js",
      "test/support/babel.js",
      "test/support/args.js",
      "test/support/log.js",
      "test/support/chai.js",
      "test/support/fixtures.js"
    ],
    "webPreferences": {
      "nodeIntegrationInWorker": true,
      "webSecurity": false
    }
  },
  "devDependencies": {
    "@babel/core": "^7.12.13",
    "@babel/preset-react": "^7.12.13",
    "@electron/fuses": "^2.1.3",
    "@electron/notarize": "^3.0.1",
    "@electron/packager": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "@img/sharp-libvips-dev": "^1.3.0",
    "@img/sharp-libvips-win32-arm64": "^1.3.0",
    "@img/sharp-libvips-win32-x64": "^1.3.0",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/react": "^16.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "c8": "^12.0.0",
    "chai": "^6.0.1",
    "chai-dom": "^1.8.2",
    "commander": "^15.0.0",
    "detect-libc": "^2.0.1",
    "electron": "^45.1.0",
    "electron-winstaller": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.0.0",
    "magic-string": "^1.4.5",
    "node-addon-api": "^8.5.0",
    "node-gyp": "^13.0.0",
    "prosemirror-test-builder": "^1.0.3",
    "react-dnd-test-backend": "^16.0.1",
    "rollup": "^4.34.8",
    "sass": "^1.64.2",
    "shelljs": "^0.10.0",
    "source-map-js": "^1.2.1",
    "spark-chamber": "^0.2.4",
    "sqleton": "^5.0.0",
    "stylelint": "^17.0.0",
    "stylelint-config-recommended-scss": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.0.0"
  },
  "dependencies": {
    "@fastify/send": "^4.2.0",
    "@inukshuk/exif": "^2.0.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@reduxjs/toolkit": "^2.0.1",
    "@tweenjs/tween.js": "^25.0.0",
    "ajv": "^8.20.0",
    "alto-xml": "^1.2.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "classnames": "^2.2.6",
    "edtf": "^4.12.0",
    "fastify": "^5.12.7",
    "fastify-plugin": "^6.0.1",
    "generic-pool": "^3.7.1",
    "immer": "^11.2.9",
    "intl-messageformat": "^12.1.4",
    "jose": "^6.2.3",
    "js-yaml": "^5.0.0",
    "jsonld": "^9.0.0",
    "n3": "^2.7.0",
    "pino": "^10.0.0",
    "pixi-filters": "^6.0.5",
    "pixi.js": "^8.5.2",
    "prosemirror-commands": "^1.1.5",
    "prosemirror-gapcursor": "^1.1.5",
    "prosemirror-history": "^1.1.3",
    "prosemirror-inputrules": "^1.1.3",
    "prosemirror-markdown": "^1.5.1",
    "prosemirror-model": "^1.13.3",
    "prosemirror-schema-basic": "^1.1.2",
    "prosemirror-schema-list": "^1.1.4",
    "prosemirror-state": "^1.3.4",
    "prosemirror-view": "^1.29.0",
    "rdjpgcom": "^1.0.0",
    "react": "^19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.0",
    "react-intl": "^12.1.4",
    "react-redux": "^9.1.0",
    "react-transition-group": "^4.4.4",
    "redux-saga": "^1.1.3",
    "semver": "^7.3.4",
    "sharp": "^0.35.4",
    "transducers.js": "^0.3.2",
    "write-file-atomic": "^8.0.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.4": true,
    "better-sqlite3": false,
    "@parcel/watcher": false,
    "fsevents": false
  },
  "patchedDependencies": {
    "v8-to-istanbul@9.3.0": "patches/v8-to-istanbul@9.3.0.patch",
    "sharp@0.35.5": "patches/sharp@0.35.5.patch",
    "better-sqlite3@13.0.3": "patches/better-sqlite3@13.0.3.patch"
  }
}
